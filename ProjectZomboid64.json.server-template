{
    "mainClass": "com/pzoptimizer/server/PZOServerEntrypoint",
    "classpath": [
        "PZOServerEngine.jar",
        "java/",
        "java/commons-compress-1.18.jar",
        "java/istack-commons-runtime.jar",
        "java/jassimp.jar",
        "java/javacsv.jar",
        "java/jaxb-api.jar",
        "java/jaxb-runtime.jar",
        "java/jinput.jar",
        "java/lwjgl.jar",
        "java/lwjgl_util.jar",
        "java/sqlite-jdbc-3.27.2.1.jar",
        "java/trove-3.0.3.jar",
        "java/uncommons-maths-1.2.3.jar"
    ],
    "vmArgs": [
        "-Xms4096m",
        "-Xmx16384m",
        "-XX:+UseG1GC",
        "-XX:InitiatingHeapOccupancyPercent=45",
        "-XX:G1ReservePercent=15",
        "-XX:+AlwaysPreTouch",
        "-Djava.awt.headless=true",
        "-Dzomboid.server=1",
        "--enable-native-access=ALL-UNNAMED",
        "--add-exports=java.base/jdk.internal.misc=ALL-UNNAMED"
    ]
}
